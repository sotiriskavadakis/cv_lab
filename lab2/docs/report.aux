\@writefile{lof}{\setforeignlanguage {greek}}
\@writefile{lot}{\setforeignlanguage {greek}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Σύγκριση πολυκλιμακωτών 2D Harris-Laplacian και Harris3D σε καρέ από βίντεο "walking". Ο 2D ανιχνευτής εντοπίζει αφθονία γωνιών σε όλο το πλαίσιο: περιγράμματα, υφές και γωνίες φόντου, σε διαφορετικές χωρικές κλίμακες. Από την άλλη ο Harris3D επιλέγει πιο εστιασμένα σημεία, κυρίως στις περιοχή των άκρων που αφορά τον βηματσμό, φιλτράροντας ανενεργές περιοχές του φόντου.}}{24}{figure.caption.30}\protected@file@percent }
\newlabel{fig:harris_comparison}{{22}{24}{Σύγκριση πολυκλιμακωτών 2D Harris-Laplacian και Harris3D σε καρέ από βίντεο "walking". Ο 2D ανιχνευτής εντοπίζει αφθονία γωνιών σε όλο το πλαίσιο: περιγράμματα, υφές και γωνίες φόντου, σε διαφορετικές χωρικές κλίμακες. Από την άλλη ο Harris3D επιλέγει πιο εστιασμένα σημεία, κυρίως στις περιοχή των άκρων που αφορά τον βηματσμό, φιλτράροντας ανενεργές περιοχές του φόντου}{figure.caption.30}{}}
\citation{laptev2008}
